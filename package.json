{
  "name": "cafe-mgmt",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:bootstrap-owner": "node --env-file-if-exists=.env deploy/bootstrap-owner.ts",
    "import:prices": "node --env-file-if-exists=.env scripts/import-price-list.ts",
    "db:clean-tests": "node --env-file-if-exists=.env scripts/clean-test-data.ts",
    "bench:replay": "node --env-file-if-exists=.env scripts/bench-replay.ts",
    "db:backup": "node --env-file-if-exists=.env deploy/backup.ts",
    "db:restore-check": "node --env-file-if-exists=.env deploy/restore-check.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.44.6",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
