# Copy to .env for local development. Never commit credentials.
# Use native PostgreSQL locally, or a separate Supabase development project.
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe
NODE_ENV=development
DATABASE_MAX_CONNECTIONS=5

# Supabase: copy the direct or SESSION pooler URL from Connect, port 5432.
# Production runtime username: cafe_app (direct) or cafe_app.<project-ref> (pooler).
# Percent-encode password characters. This app uses Postgres directly, no API keys.
# DATABASE_URL=postgresql://cafe_app.<project-ref>:<encoded-password>@<session-pooler-host>:5432/postgres
# Download the database CA certificate from Supabase Database Settings.
# Paste the PEM here (quoted multiline), or use literal \n between its lines.
DATABASE_SSL_CA=

# Migration/admin credentials: local secure shell or GitHub production secrets only.
# In development db:migrate falls back to DATABASE_URL; production requires this URL.
# Use postgres (direct) or postgres.<project-ref> (session pooler), port 5432.
DATABASE_MIGRATION_URL=
# Creates/refreshes cafe_app. Must match the password in Render's DATABASE_URL.
APP_DB_PASSWORD=

# Sample-data seed only, never an automatic production startup step.
# Required by db:seed outside development; never required by the web service.
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=owner@cafe.local

# Initial owner for an EMPTY production database; no sample stock or recipes.
# Run db:bootstrap-owner with migration/admin credentials once, then remove these.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Backup/restore: native pg_dump and pg_restore must be installed and on PATH.
# Supabase dumps cover only the app's public and drizzle schemas.
BACKUP_DATABASE_URL=
BACKUP_DIR=backups
# An EMPTY, separate test database/project. Never the production project.
RESTORE_DATABASE_URL=
RESTORE_DATABASE_SSL_CA=
