# Every variable this app reads. Copy to .env and fill in.
# src/lib/env.ts refuses to start if a required one is missing, and names all of them at
# once rather than one per restart.

# ---- Required, always -------------------------------------------------------
# Local development (app on the host, Postgres in Docker):
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe
# Inside the compose stack the host is the SERVICE NAME, not localhost:
#   DATABASE_URL=postgres://cafe:cafe@db:5432/cafe
# localhost inside a container is the container itself. env.ts rejects that combination
# in production because it is the classic compose wiring mistake.

# ---- Required unless NODE_ENV=development -----------------------------------
# The seeded owner account holds every permission in the system, so it must not be
# created with a password published in this repository. The seed refuses to run without
# this outside development.
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=owner@cafe.local

# ---- Local development only -------------------------------------------------
# Do NOT copy this line to the server. It is what allows the seed to fall back to a
# default owner password, and what relaxes the localhost check above.
NODE_ENV=development

# ---- Compose stack ----------------------------------------------------------
# Defaults are fine locally; all are overridable.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=cafe
POSTGRES_DB=cafe

# Caddy. `:80` locally serves plain HTTP. On the VPS set this to the real hostname
# (e.g. order.cafename.com) and Caddy provisions a TLS certificate on its own.
SITE_ADDRESS=:80
# Host ports for the local stack. 8080/8443 to stay clear of anything already bound.
HTTP_PORT=8080
HTTPS_PORT=8443
